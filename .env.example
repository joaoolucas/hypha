# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=                         # from @BotFather (required)

# ── Whale-tracker channel (the pivot) ────────────────────────────────────────
ALERTS_CHANNEL_ID=                 # @yourchannel or -100… id; add the bot as channel admin
ALERTS_ENABLED=true                # master switch for the trade poller
ADMIN_IDS=                         # comma/space-separated tg user ids allowed to /track
BUY_ALERT_USD=1000                 # post a BUY at/above this USD size
SELL_ALERT_USD=10000               # post a SELL only at/above this (big dumps)
WHALE_PORTFOLIO_USD=50000          # buyer tagged 🐋 at/above this total portfolio USD
HOT_POOLS_MAX=30                   # how many hot pools to watch
TRADES_POLL_SECS=150               # trade-poll cycle interval
DISCOVERY_POLL_SECS=1800           # how often the hot-pool set refreshes
FOLLOW_ENABLED=true                # auto-follow recurring big buyers into cold tokens
FOLLOW_POLL_SECS=180               # followed-wallet poll interval
FOLLOWED_MAX=150                   # cap on followed wallets
PROMOTE_MIN_BUYS=3                 # qualifying big buys before auto-follow

# ── Data providers ───────────────────────────────────────────────────────────
TONAPI_KEY=                        # tonapi.io / tonconsole.com — primary source
TONAPI_BASE=https://tonapi.io
TONCENTER_KEY=                     # toncenter.com v3 — fallback
TONCENTER_BASE=https://toncenter.com/api/v3
STONFI_BASE=https://api.ston.fi
DEDUST_BASE=https://api.dedust.io/v2
SWAPCOFFEE_BASE=https://backend.swap.coffee
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2

# ── Referral / monetization ──────────────────────────────────────────────────
STONFI_REFERRAL_ADDRESS=           # our TON address that earns STON.fi swap fees
STONFI_REFERRAL_PERCENT=0.1        # V2 pools, 0..1
SWAPCOFFEE_REFERRAL_NAME=          # our swap.coffee affiliate handle
REDIRECT_BASE=https://hypha.link   # public base of the redirect service

# ── Infra ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://hypha:hypha@postgres:5432/hypha
LOG_LEVEL=INFO
ANALYSIS_TTL=300                   # seconds to cache a token analysis
USER_RATE_PER_MIN=8                # /analyze calls per user per minute
SENTRY_DSN=
